# Mumita Holdings API: every environment variable config/settings.py reads.
#
# Copy to .env next to manage.py (git-ignored; chmod 600) or enter them in
# cPanel > Setup Python App > Environment variables. On Namecheap, put them in
# .env as well: the .cpanel.yml deploy task (migrate, collectstatic) and cron
# do not see the cPanel per-app variables. Values already in the process
# environment win over .env.
#
# EVERY VALUE HERE IS A PLACEHOLDER. This repository is public: never commit
# real values. Commented lines show the default.

# --- Core -------------------------------------------------------------------
DJANGO_DEBUG=0
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_ALLOWED_HOSTS=api.mumitaholdings.com
# Unguessable path for the Django admin; admin/ is refused.
DJANGO_ADMIN_URL=change-me-cms/

# --- Frontend, CORS, CSRF, cookies --------------------------------------------
DJANGO_FRONTEND_URL=https://mumitaholdings.com
DJANGO_CORS_ALLOWED_ORIGINS=https://mumitaholdings.com,https://www.mumitaholdings.com
# Extra CSRF origins; the CORS origins above are trusted automatically.
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.mumitaholdings.com
# Shares sessionid/csrftoken between mumitaholdings.com and api. Unset in development.
DJANGO_COOKIE_DOMAIN=.mumitaholdings.com
# Hosts whose links in articles are not "external" (no rel added).
DJANGO_SITE_HOSTS=mumitaholdings.com,www.mumitaholdings.com

# --- Keys shared with the frontend Worker (same values as its secrets) ---------
# openssl rand -base64 48
REVALIDATE_KEY=change-me-random-string
ANALYTICS_INGEST_KEY=change-me-another-random-string
# REVALIDATE_TIMEOUT=3

# --- Client IP (throttling, login lock-out, IP hashes) -------------------------
# Default: trust nothing, use REMOTE_ADDR. See README "Client IP".
# Proxies of our own hosting that append to X-Forwarded-For (0 when api is
# DNS-only and Apache/LiteSpeed sees the visitor directly).
DJANGO_NUM_PROXIES=0
# The Worker sends X-Proxy-Key: <this> plus X-Forwarded-For: <CF-Connecting-IP>.
DJANGO_TRUSTED_PROXY_KEY=change-me-third-random-string
# Or/also trust by source address (IPs/CIDRs, comma-separated). Empty: none.
DJANGO_TRUSTED_PROXIES=
# Header the trusted forwarder puts the visitor IP in (its first hop is used).
# DJANGO_TRUSTED_PROXY_HEADER=X-Forwarded-For

# --- HTTPS (applied when DJANGO_DEBUG=0) ---------------------------------------
# 1 only if api is proxied through Cloudflare (orange cloud) or another TLS proxy.
DJANGO_BEHIND_PROXY=0
# DJANGO_SECURE_SSL_REDIRECT=1
# Start at 3600; 31536000 once HTTPS is confirmed.
DJANGO_HSTS_SECONDS=3600
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
# DJANGO_HSTS_PRELOAD=0

# --- Database ------------------------------------------------------------------
# mysql (Namecheap MySQL/MariaDB via PyMySQL), postgresql or sqlite (development).
DJANGO_DB_ENGINE=mysql
DJANGO_DB_NAME=cpuser_mumita_api
DJANGO_DB_USER=cpuser_api
DJANGO_DB_PASSWORD=change-me
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=3306
# DJANGO_DB_CONN_MAX_AGE=0
# sqlite only: file path (default db.sqlite3 next to manage.py).
# DJANGO_SQLITE_PATH=

# --- Static and media files ---------------------------------------------------
# Uploads, inside the api subdomain's document root so Apache serves /media/.
DJANGO_MEDIA_ROOT=/home/cpuser/api.mumitaholdings.com/media
# DJANGO_MEDIA_URL=/media/
# Absolute origin at the start of media URLs in API responses.
DJANGO_MEDIA_BASE_URL=https://api.mumitaholdings.com
# collectstatic target; WhiteNoise serves it from the app.
DJANGO_STATIC_ROOT=/home/cpuser/mumita-api/staticfiles
# 1 only if Apache does not serve DJANGO_MEDIA_ROOT itself (Django then does).
DJANGO_SERVE_MEDIA=0
# IMAGE_UPLOAD_MAX_BYTES=15728640

# --- Email ---------------------------------------------------------------------
# Unset DJANGO_EMAIL_HOST: emails are printed to the console (development).
DJANGO_EMAIL_HOST=mail.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=website@example.com
DJANGO_EMAIL_PASSWORD=change-me
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=Mumita Holdings <website@example.com>
# Staff inbox for new enquiries (role addresses, comma-separated).
ENQUIRY_NOTIFY_EMAILS=info@example.com

# --- Accounts, enquiries, testimonials -------------------------------------------
# ACCOUNT_EMAIL_DOMAIN=mumitaholdings.com
# AXES_FAILURE_LIMIT=5
# LOGIN_THROTTLE_RATE=30/hour
# ENQUIRY_RETENTION_DAYS=365
# ENQUIRY_THROTTLE_RATE=5/hour
# ENQUIRY_LOG_LEVEL=INFO
# TESTIMONIAL_THROTTLE_RATE=3/hour
